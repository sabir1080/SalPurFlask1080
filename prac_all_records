
# prac_all_records.py
from app import app, db, User

# Flask app context چاہیے تاکہ database access ہو
with app.app_context():
    all_users = User.query.all()
    if not all_users:
        print("No records found. EOF reached.")
    else:
        print("Browsing all users:")
        for i, u in enumerate(all_users):
            print(f"Record {i+1}: ID={u.id}, Email={u.email}, Name={u.name}")
