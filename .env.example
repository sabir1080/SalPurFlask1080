# Copy this file to .env and fill in your values
SECRET_KEY=your_random_secret_key
SECURITY_PASSWORD_SALT=your_random_salt

# Your business name and tagline (shown on invoices, reports, navbar)
COMPANY_NAME=TradeFlow
COMPANY_TAGLINE=Inventory & Accounts Management

# Set to true only if you want public self-registration (default: disabled)
ALLOW_SIGNUP=false

# Anthropic Claude API Key (get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Gmail SMTP (App Password required — NOT your normal Gmail password)
# Create App Password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
