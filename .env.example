# Copy this file to .env and fill in your values
SECRET_KEY=your_random_secret_key
SECURITY_PASSWORD_SALT=your_random_salt

# Your business name and tagline (shown on invoices, reports, navbar)
COMPANY_NAME=Your Company Name
APP_NAME=Your App Name
COMPANY_TAGLINE=Inventory & Accounts Management
# Developer credit shown in the footer and About page
DESIGNED_DEVELOPED=Your Name (email / whatsapp)

# The business's own clock. Every date the system writes — an invoice date, a month-end
# entry — is "today" here, not on whatever server the app happens to run on.
# e.g. Asia/Karachi, Asia/Dubai, Europe/London, America/New_York. Defaults to UTC.
APP_TIMEZONE=Asia/Karachi

# The month your fiscal year starts in.
#   1  = January  — UAE, USA, and most of the world
#   7  = July     — Pakistan
#   4  = April    — UK, India
# A year that does not start in January is named for both, e.g. "2026-27", and invoice
# numbering restarts with it. Get this right before you enter any data: it decides which
# periods exist, and nothing can be posted on a date no period covers.
FISCAL_YEAR_START_MONTH=1

# Shown on invoice totals and headline figures. Never converted — one company, one currency.
# e.g. Rs, PKR, £, $, AED, ₹. Leave blank for none.
CURRENCY=Rs

# Set to true only if you want public self-registration (default: disabled)
ALLOW_SIGNUP=false

# Set to true on the public demo deployment to disable the "Change Password"
# form on the user profile page (default: disabled)
DEMO_MODE=false

# Anthropic Claude API Key (get from console.anthropic.com)
#ANTHROPIC_API_KEY=sk-ant-...

# Gmail SMTP (App Password required — NOT your normal Gmail password)
# Create App Password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
